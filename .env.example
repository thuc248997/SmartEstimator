# Copy to .env — never commit .env
DJANGO_SECRET_KEY=change-me-dev-only
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,smartestimator-api,smartestimator.around-ai.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://smartestimator.around-ai.com
GUNICORN_WORKERS=3
POSTGRES_DB=smartestimator
